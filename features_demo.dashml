version: "1.0"
title: "Feature Demo — Grid Layout, Annotations, Log Scale, Reference Lines"
style: "dracula"

data:
  type: csv
  path: "dashml_new/startup_funding.csv"

pages:
  - id: "grid_layout"
    title: "Grid Layout (2x2)"
    layout:
      columns: 2
    charts:
      - id: "bar_top_industries"
        type: bar
        title: "Top Industries by Funding"
        x: "industry"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "desc"
        limit: 10

      - id: "pie_rounds"
        type: pie
        title: "Funding Rounds"
        x: "funding_round"
        y: "funding_amount"
        agg: "sum"

      - id: "line_over_time"
        type: line
        title: "Funding Over Time"
        x: "year_founded"
        y: "funding_amount"
        agg: "sum"
        x_type: "date"

      - id: "scatter_age_funding"
        type: scatter
        title: "Company Age vs Funding"
        x: "year_founded"
        y: "funding_amount"

  - id: "annotations_demo"
    title: "Annotations & Reference Lines"
    layout:
      columns: 2
    charts:
      - id: "bar_annotated"
        type: bar
        title: "Top Cities (with annotation)"
        x: "city"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "desc"
        limit: 8
        annotations:
          - text: "Bay Area dominance"
            x: "San Francisco"
            y: 50000000
            color: "#ff5555"

      - id: "bar_with_refline"
        type: bar
        title: "Funding by Industry (with target)"
        x: "industry"
        y: "funding_amount"
        agg: "mean"
        sort: "y"
        sort_order: "desc"
        limit: 10
        reference_lines:
          - axis: y
            value: 5000000
            label: "Target"
            style: dashed

  - id: "log_scale_demo"
    title: "Log Scale"
    charts:
      - id: "scatter_log"
        type: scatter
        title: "Funding Distribution (Log Scale)"
        x: "year_founded"
        y: "funding_amount"
        y_scale: "log"

  - id: "three_col_grid"
    title: "3-Column Grid"
    layout:
      columns: 3
    charts:
      - id: "m1"
        type: metric
        title: "Total Funding"
        y: "funding_amount"
        agg: "sum"
        format: ",.0f"
        suffix: " USD"

      - id: "m2"
        type: metric
        title: "Companies"
        y: "funding_amount"
        agg: "count"
        format: ",.0f"

      - id: "m3"
        type: metric
        title: "Avg Funding"
        y: "funding_amount"
        agg: "mean"
        format: ",.0f"
        suffix: " USD"

      - id: "hist1"
        type: histogram
        title: "Funding Distribution"
        x: "funding_amount"
        y: "funding_amount"
        bins: 30

      - id: "bar_rounds"
        type: bar
        title: "By Round"
        x: "funding_round"
        y: "funding_amount"
        agg: "count"

      - id: "area_trend"
        type: area
        title: "Trend"
        x: "year_founded"
        y: "funding_amount"
        agg: "sum"
        x_type: "date"
