version: "1.0"
title: "Global Startup Funding Dashboard"
style: "dracula"

data:
  type: sql
  path: public.startup_funding

pages:
  - id: "overview"
    title: "Overview"
    description: "Key metrics and high-level funding trends"
    charts:
      - id: "metric_total_funding"
        type: "metric"
        title: "Total Funding ($M)"
        y: "funding_amount"
        agg: "sum"
        format: "decimal:1"
        suffix: "M"

      - id: "metric_deal_count"
        type: "metric"
        title: "Total Deals"
        y: "funding_amount"
        agg: "count"
        format: "integer"

      - id: "metric_avg_valuation"
        type: "metric"
        title: "Avg Valuation ($M)"
        y: "valuation"
        agg: "mean"
        format: "decimal:1"
        suffix: "M"

      - id: "line_funding_over_time"
        type: "line"
        title: "Funding Over Time"
        x: "funding_date"
        y: "funding_amount"
        agg: "sum"
        x_type: "date"

      - id: "area_deals_over_time"
        type: "area"
        title: "Deal Count Over Time"
        x: "funding_date"
        y: "funding_amount"
        agg: "count"
        x_type: "date"

      - id: "pie_by_stage"
        type: "pie"
        title: "Deals by Funding Stage"
        x: "stage"
        y: "funding_amount"
        agg: "count"

  - id: "by_industry"
    title: "By Industry"
    description: "Funding breakdown across industries"
    charts:
      - id: "bar_funding_by_industry"
        type: "bar"
        title: "Total Funding by Industry"
        x: "industry"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "asc"

      - id: "stacked_bar_industry_stage"
        type: "stacked_bar"
        title: "Industry Funding by Stage"
        x: "industry"
        y: "funding_amount"
        agg: "sum"
        group: "stage"
        sort: "y"
        sort_order: "asc"

      - id: "grouped_bar_industry_stage"
        type: "grouped_bar"
        title: "Industry Deal Count by Stage"
        x: "industry"
        y: "funding_amount"
        agg: "count"
        group: "stage"
        sort: "y"
        sort_order: "asc"

      - id: "heatmap_industry_country"
        type: "heatmap"
        title: "Funding Heatmap: Industry vs Country"
        x: "industry"
        y: "funding_amount"
        agg: "sum"
        group: "country"

  - id: "geography"
    title: "Geography"
    description: "Where startup funding flows globally"
    charts:
      - id: "geo_funding_by_country"
        type: "geo"
        title: "Total Funding by Country"
        x: "country"
        y: "funding_amount"
        agg: "sum"
        geo_encoding: "name"

      - id: "bar_top_countries"
        type: "bar"
        title: "Top 10 Countries by Funding"
        x: "country"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "desc"
        limit: 10

      - id: "bar_top_cities"
        type: "bar"
        title: "Top 10 Cities by Deal Count"
        x: "city"
        y: "funding_amount"
        agg: "count"
        sort: "y"
        sort_order: "desc"
        limit: 10

  - id: "deep_dive"
    title: "Deep Dive"
    description: "Distributions and correlations"
    charts:
      - id: "scatter_funding_vs_valuation"
        type: "scatter"
        title: "Funding Amount vs Valuation"
        x: "funding_amount"
        y: "valuation"

      - id: "histogram_funding"
        type: "histogram"
        title: "Distribution of Funding Amounts"
        x: "funding_amount"
        y: "funding_amount"
        bins: 30

      - id: "box_funding_by_stage"
        type: "box"
        title: "Funding Distribution by Stage"
        x: "stage"
        y: "funding_amount"

      - id: "bubble_industry"
        type: "bubble"
        title: "Industries: Funding vs Valuation (sized by Employees)"
        x: "funding_amount"
        y: "valuation"
        agg: "mean"
        group: "industry"
        size: "employees"
