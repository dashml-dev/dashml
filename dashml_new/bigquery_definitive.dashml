version: 0.1
title: "UK Flight Punctuality Dashboard"
style: "dracula"

data:
  type: bigquery
  path: "gold.punctuality_gold"

derived_fields:
  - name: "on_time_rate"
    expression: "100 - {pct_delayed_15plus}"
  - name: "delay_index"
    expression: "({average_delay_mins} + {pct_delayed_15plus}) / 2"

pages:
  - id: "airline_performance"
    title: "Airline Performance"
    description: "Delays and cancellations by airline and airport"
    filters:
      - field: "scheduled_charter"
        type: "select"
        label: "Flight Type"
      - field: "origin_destination_country"
        type: "multiselect"
        label: "Country"
    charts:
      - id: "total_flights_kpi"
        type: "metric"
        title: "Total Flights"
        y: "total_flights"
        agg: "sum"
        format: "integer"

      - id: "avg_delay_kpi"
        type: "metric"
        title: "Avg Delay"
        y: "average_delay_mins"
        agg: "mean"
        format: "decimal:1"
        suffix: " mins"

      - id: "pct_delayed_kpi"
        type: "metric"
        title: "% Delayed 15+ mins"
        y: "pct_delayed_15plus"
        agg: "mean"
        format: "decimal:1"
        suffix: "%"

      - id: "bar_delay_by_airline"
        type: "bar"
        title: "Average Delay by Airline (mins)"
        x: "airline_name"
        y: "average_delay_mins"
        agg: "mean"
        sort: "y"
        sort_order: "desc"
        limit: 20

      - id: "bar_on_time_by_airline"
        type: "bar"
        title: "On-Time Rate by Airline (%)"
        x: "airline_name"
        y: "on_time_rate"
        agg: "mean"
        sort: "y"
        sort_order: "desc"
        limit: 15

      - id: "pie_scheduled_charter"
        type: "pie"
        title: "Flights: Scheduled vs Charter"
        x: "scheduled_charter"
        y: "total_flights"
        agg: "sum"

      - id: "grouped_bar_airport_delay"
        type: "grouped_bar"
        title: "Delay Rate by Top Airports (Scheduled vs Charter)"
        x: "reporting_airport"
        y: "pct_delayed_15plus"
        agg: "mean"
        group: "scheduled_charter"
        sort: "y"
        sort_order: "desc"
        limit: 15

      - id: "stacked_bar_country_flights"
        type: "stacked_bar"
        title: "Flights by Country (Scheduled vs Charter)"
        x: "origin_destination_country"
        y: "total_flights"
        agg: "sum"
        group: "scheduled_charter"
        sort: "y"
        sort_order: "desc"
        limit: 15

      - id: "geo_flights_by_country"
        type: "geo"
        title: "Total Flights by Destination Country"
        x: "origin_destination_country"
        y: "total_flights"
        agg: "sum"

  - id: "time_series"
    title: "Trends Over Time"
    description: "Monthly trends in delays and flight volumes"
    charts:
      - id: "line_delay_over_time"
        type: "line"
        title: "Average Delay Over Time"
        x: "reporting_month"
        y: "average_delay_mins"
        agg: "mean"
        x_type: "date"

      - id: "area_flights_over_time"
        type: "area"
        title: "Total Flights Over Time"
        x: "reporting_month"
        y: "total_flights"
        agg: "sum"
        x_type: "date"

  - id: "distribution"
    title: "Distribution & Relationships"
    description: "Scatter plots, histograms, box plots, bubble charts, and heatmaps"
    charts:
      - id: "scatter_delay_vs_cancellation"
        type: "scatter"
        title: "Average Delay vs Cancellation Rate"
        x: "average_delay_mins"
        y: "cancellation_rate"
        agg: "mean"

      - id: "histogram_delays"
        type: "histogram"
        title: "Distribution of Average Delays"
        x: "average_delay_mins"
        y: "airline_name"
        agg: "count"
        bins: 25

      - id: "box_delay_by_airline"
        type: "box"
        title: "Delay Distribution by Top Airlines"
        x: "airline_name"
        y: "average_delay_mins"

      - id: "bubble_airport_performance"
        type: "bubble"
        title: "Airport: Delay vs Bad Events Rate"
        x: "pct_delayed_15plus"
        y: "bad_events_rate"
        size: "total_flights"
        group: "reporting_airport"
        agg: "mean"

      - id: "heatmap_airline_country"
        type: "heatmap"
        title: "Delay Rate by Airline and Country"
        x: "origin_destination_country"
        y: "pct_delayed_15plus"
        group: "airline_name"
        agg: "mean"
