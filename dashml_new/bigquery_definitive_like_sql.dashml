version: 0.1
title: "BigQuery Definitive - All Chart Types"
style: "dracula"

data:
  type: bigquery
  path: "sales.orders"

pages:
  - id: "categorical_charts"
    title: "Categorical Charts"
    description: "Bar charts and pie charts for categorical data"
    charts:
      - id: "total_revenue_kpi"
        type: "metric"
        title: "Total Revenue"
        y: "total_amount"
        agg: "sum"
        format: "integer"

      - id: "total_orders_kpi"
        type: "metric"
        title: "Total Orders"
        y: "order_id"
        agg: "count"
        format: "integer"

      - id: "avg_order_value_kpi"
        type: "metric"
        title: "Avg Order Value"
        y: "total_amount"
        agg: "mean"
        format: "decimal:2"

      - id: "bar_sales_by_country"
        type: "bar"
        title: "Total Sales by Country"
        x: "shipping_address_country"
        y: "total_amount"
        agg: "sum"

      - id: "pie_orders_by_status"
        type: "pie"
        title: "Orders by Status"
        x: "status"
        y: "order_id"
        agg: "count"

      - id: "grouped_bar_country_status"
        type: "grouped_bar"
        title: "Orders by Country (Grouped by Status)"
        x: "shipping_address_country"
        y: "order_id"
        agg: "count"
        group: "status"
        sort: "y"
        sort_order: "desc"

      - id: "stacked_bar_payment_status"
        type: "stacked_bar"
        title: "Orders by Payment Method (Stacked by Status)"
        x: "payment_method"
        y: "order_id"
        agg: "count"
        group: "status"

      - id: "geo_sales_by_country"
        type: "geo"
        title: "Sales by Country (Map)"
        x: "shipping_address_country"
        y: "total_amount"
        agg: "sum"

  - id: "time_series"
    title: "Time Series Charts"
    description: "Line and area charts for temporal trends"
    charts:
      - id: "line_orders_over_time"
        type: "line"
        title: "Orders Over Time"
        x: "order_date"
        y: "order_id"
        agg: "count"
        x_type: "date"

      - id: "area_revenue_over_time"
        type: "area"
        title: "Revenue Over Time"
        x: "order_date"
        y: "total_amount"
        agg: "sum"
        x_type: "date"

  - id: "distribution"
    title: "Distribution & Relationships"
    description: "Scatter plots, histograms, box plots, bubble charts, and heatmaps"
    charts:
      - id: "scatter_amount_vs_tax"
        type: "scatter"
        title: "Order Amount vs Tax Amount"
        x: "total_amount"
        y: "tax_amount"
        agg: "sum"

      - id: "histogram_order_amounts"
        type: "histogram"
        title: "Distribution of Order Amounts"
        x: "total_amount"
        y: "order_id"
        agg: "count"
        bins: 20

      - id: "box_amount_by_status"
        type: "box"
        title: "Order Amount Distribution by Status"
        x: "status"
        y: "total_amount"

      - id: "bubble_region_sales"
        type: "bubble"
        title: "Sales vs Tax by Region"
        group: "shipping_address_state"
        x: "total_amount"
        y: "tax_amount"
        size: "total_amount"
        agg: "sum"

      - id: "heatmap_country_status"
        type: "heatmap"
        title: "Order Count by Country and Status"
        x: "shipping_address_country"
        y: "order_id"
        group: "status"
        agg: "count"
