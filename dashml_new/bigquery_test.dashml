version: 0.1
title: "BigQuery Test - Startup Funding"
style: "dracula"

data:
  type: bigquery
  path: "sales.orders"

pages:
  - id: "overview"
    title: "Overview"
    charts:
      - id: "total_funding_kpi"
        type: "metric"
        title: "Total Funding"
        y: "funding_amount"
        agg: "sum"
        format: "integer"

      - id: "total_deals_kpi"
        type: "metric"
        title: "Total Deals"
        y: "funding_amount"
        agg: "count"
        format: "integer"

      - id: "bar_by_industry"
        type: "bar"
        title: "Funding by Industry"
        x: "industry"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "desc"

      - id: "pie_by_stage"
        type: "pie"
        title: "Deals by Stage"
        x: "stage"
        y: "funding_amount"
        agg: "count"

      - id: "line_over_time"
        type: "line"
        title: "Funding Over Time"
        x: "funding_date"
        y: "funding_amount"
        agg: "sum"
        x_type: "date"

      - id: "scatter_funding_vs_valuation"
        type: "scatter"
        title: "Funding vs Valuation"
        x: "funding_amount"
        y: "valuation"

      - id: "geo_by_country"
        type: "geo"
        title: "Funding by Country"
        x: "country"
        y: "funding_amount"
        agg: "sum"
        geo_encoding: "name"

      - id: "top_countries"
        type: "bar"
        title: "Top 10 Countries"
        x: "country"
        y: "funding_amount"
        agg: "sum"
        sort: "y"
        sort_order: "desc"
        limit: 10
