version: 0.000000001
title: "Sales Analytics Dashboard"
style: "styles/dracula.dmls"

data:
  type: csv
  path: "data/example.csv"

pages:
  - id: "overview"
    title: "📊 Overview"
    description: "High-level sales metrics and KPIs"
    charts:
      - id: "total_sales_by_country"
        type: "bar"
        title: "Total Sales by Country"
        x: "country"
        y: "sales"
        agg: "sum"

      - id: "country_sales_breakdown"
        type: "pie"
        title: "Market Share by Country"
        x: "country"
        y: "sales"
        agg: "sum"

      - id: "sales_geo"
        type: "geo"
        title: "Sales by Country"
        x: "country"
        y: "sales"
        agg: "sum"

  - id: "trends"
    title: "📈 Trends"
    description: "Sales trends and patterns over time"
    charts:
      - id: "sales_over_time"
        type: "line"
        title: "Sales Over Time"
        x: "date"
        y: "sales"
        agg: "sum"

      - id: "sales_area"
        type: "area"
        title: "Cumulative Sales Over Time"
        x: "date"
        y: "sales"
        agg: "sum"

      - id: "average_sales_trend"
        type: "scatter"
        title: "Average Daily Sales"
        x: "date"
        y: "sales"
        agg: "mean"

  - id: "breakdown"
    title: "🔍 Breakdown"
    description: "Sales by country and product"
    charts:
      - id: "stacked_sales"
        type: "stacked_bar"
        title: "Sales by Country and Product (Stacked)"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

      - id: "grouped_sales"
        type: "grouped_bar"
        title: "Sales by Country and Product (Grouped)"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

      - id: "sales_heatmap"
        type: "heatmap"
        title: "Sales Heatmap"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

  - id: "analysis"
    title: "📉 Analysis"
    description: "Distribution and statistical charts"
    charts:
      - id: "sales_distribution"
        type: "histogram"
        title: "Sales Distribution"
        x: "sales"
        y: "sales"

      - id: "sales_box"
        type: "box"
        title: "Sales Distribution by Country"
        x: "country"
        y: "sales"

      - id: "sales_bubble"
        type: "bubble"
        title: "Sales Bubble Chart"
        group: "country"
        x: "sales"
        y: "sales"
        size: "sales"
        agg: "sum"
