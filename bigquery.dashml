version: 0.000000001
title: "Sales Analytics Dashboard"
style: "styles/dracula.dmls"

data:
  type: bigquery
  path: products_postresql.orders_one_week

pages:
  - id: "overview"
    title: "📊 Overview"
    description: "High-level sales metrics and KPIs"
    charts:
      - id: "total_sales_by_country"
        type: "bar"
        title: "Total Sales by State"
        x: "shipping_address_state"
        y: "total_amount"
        agg: "sum"

      - id: "country_sales_breakdown"
        type: "pie"
        title: "Market Share by State"
        x: "shipping_address_state"
        y: "total_amount"
        agg: "sum"

  - id: "trends"
    title: "📈 Trends"
    description: "Sales trends and patterns over time"
    charts:
      - id: "sales_over_time"
        type: "line"
        title: "Sales Over Time"
        x: "order_date"
        x_type: "date"
        y: "total_amount"
        agg: "sum"

      - id: "average_sales_trend"
        type: "line"
        title: "Average Daily Sales"
        x: "order_date"
        x_type: "date"
        y: "total_amount"
        agg: "mean"

