# DashML — environment configuration for the generated dashboard.
# Copy this file to .env and fill in the values for your environment.
# .env is gitignored; never commit real credentials.

# postgresql, mysql, or sqlite
DASHML_DB_TYPE=postgresql

# database host (e.g. localhost or db.example.com)
DASHML_DB_HOST=localhost

# database port (e.g. 5432 for PostgreSQL, 3306 for MySQL)
DASHML_DB_PORT=5432

# database name (or file path for sqlite)
DASHML_DB_NAME=your_database

# database user
DASHML_DB_USER=your_user

# database password (the only required secret)
DASHML_DB_PASSWORD=
