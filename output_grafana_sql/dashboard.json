    {
      "id": 18,
      "type": "table",
      "pluginVersion": "12.4.0",
      "title": "Order Count by Country and Status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 55
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DATASOURCE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DATASOURCE}"
          },
          "rawSql": "SELECT shipping_address_country AS x, status AS heatmap_y, COUNT(order_id) AS y FROM public.orders WHERE 1=1 AND shipping_address_country IN (SELECT shipping_address_country FROM public.orders GROUP BY shipping_address_country ORDER BY COUNT(*) DESC LIMIT 20) AND status IN (SELECT status FROM public.orders GROUP BY status ORDER BY COUNT(*) DESC LIMIT 20) GROUP BY shipping_address_country, status",
          "format": "table"
        }
      ],
      "fieldConfig": {
