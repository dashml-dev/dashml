    {
      "id": 7,
      "type": "barchart",
      "pluginVersion": "12.4.0",
      "title": "Orders by Country (Grouped by Status)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${DS_DATASOURCE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${DS_DATASOURCE}"
          },
          "rawSql": "SELECT agg.x, agg.grp, agg.y FROM (SELECT shipping_address_country AS x, status AS grp, COUNT(order_id) AS y FROM public.orders WHERE 1=1 GROUP BY shipping_address_country, status) agg JOIN (SELECT shipping_address_country AS x, COUNT(order_id) AS x_total FROM public.orders WHERE 1=1 GROUP BY shipping_address_country) totals ON agg.x = totals.x ORDER BY totals.x_total DESC, agg.x",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "axisBorderShow": false,
            "fillOpacity": 80,
            "gradientMode": "none",
            "lineWidth": 1
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
