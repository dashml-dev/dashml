version: 0.000000001
title: "All Chart Types Demo"
style: "styles/dracula.dmls"

data:
  type: csv
  path: "data/example.csv"

pages:
  - id: "basic"
    title: "📊 Basic Charts"
    description: "Bar, line, scatter, pie"
    charts:
      - id: "bar_example"
        type: "bar"
        title: "Bar Chart"
        x: "country"
        y: "sales"
        agg: "sum"

      - id: "line_example"
        type: "line"
        title: "Line Chart"
        x: "date"
        y: "sales"
        agg: "sum"

      - id: "scatter_example"
        type: "scatter"
        title: "Scatter Plot"
        x: "date"
        y: "sales"
        agg: "mean"

      - id: "pie_example"
        type: "pie"
        title: "Pie Chart"
        x: "country"
        y: "sales"
        agg: "sum"

  - id: "distributions"
    title: "📈 Distributions"
    description: "Area, histogram, box"
    charts:
      - id: "area_example"
        type: "area"
        title: "Area Chart - Sales Over Time"
        x: "date"
        y: "sales"
        agg: "sum"

      - id: "histogram_example"
        type: "histogram"
        title: "Histogram - Sales Distribution"
        x: "sales"
        y: "sales"

      - id: "box_example"
        type: "box"
        title: "Box Plot - Sales by Country"
        x: "country"
        y: "sales"

  - id: "grouped"
    title: "📊 Grouped Charts"
    description: "Stacked bar, grouped bar, heatmap"
    charts:
      - id: "stacked_example"
        type: "stacked_bar"
        title: "Stacked Bar - Sales by Country and Product"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

      - id: "grouped_example"
        type: "grouped_bar"
        title: "Grouped Bar - Sales by Country and Product"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

      - id: "heatmap_example"
        type: "heatmap"
        title: "Heatmap - Sales by Country and Product"
        x: "country"
        y: "sales"
        group: "product"
        agg: "sum"

  - id: "special"
    title: "🌍 Special Charts"
    description: "Bubble, geo"
    charts:
      - id: "bubble_example"
        type: "bubble"
        title: "Bubble Chart - Sales by Country"
        group: "country"
        x: "sales"
        y: "sales"
        size: "sales"
        agg: "sum"

      - id: "geo_example"
        type: "geo"
        title: "World Map - Sales by Country"
        x: "country"
        y: "sales"
        agg: "sum"
