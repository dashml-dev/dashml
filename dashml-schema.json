{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dashml.dev/schema/v0.1.json",
  "title": "DashML Specification",
  "description": "Schema for DashML dashboard specification files (.dashml)",
  "type": "object",
  "required": ["version", "data"],
  "oneOf": [
    { "required": ["charts"] },
    { "required": ["pages"] }
  ],
  "properties": {
    "version": {
      "description": "DashML specification version",
      "oneOf": [
        { "type": "string" },
        { "type": "number" }
      ]
    },
    "title": {
      "type": "string",
      "description": "Dashboard title"
    },
    "style": {
      "type": "string",
      "description": "Path to a .dmls theme file"
    },
    "data": {
      "type": "object",
      "description": "Data source configuration",
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "description": "Type of data source",
          "enum": ["csv", "sql", "bigquery"]
        },
        "path": {
          "type": "string",
          "description": "File path (CSV), schema.table (SQL), or dataset.table (BigQuery)"
        },
        "database_id": {
          "type": "integer",
          "description": "Superset database ID (SQL data sources)"
        }
      }
    },
    "charts": {
      "type": "array",
      "description": "Array of chart specifications (single-page mode)",
      "minItems": 1,
      "items": { "$ref": "#/definitions/chart" }
    },
    "pages": {
      "type": "array",
      "description": "Array of page specifications (multi-page mode)",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "charts"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique page identifier"
          },
          "title": {
            "type": "string",
            "description": "Page title"
          },
          "description": {
            "type": "string",
            "description": "Page description"
          },
          "charts": {
            "type": "array",
            "description": "Charts on this page",
            "minItems": 1,
            "items": { "$ref": "#/definitions/chart" }
          },
          "layout": {
            "type": "object",
            "description": "Page layout configuration for grid/subplot arrangement",
            "properties": {
              "columns": {
                "type": "integer",
                "minimum": 1,
                "description": "Number of columns for chart grid layout"
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "chart": {
      "type": "object",
      "required": ["id", "type", "x", "y"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique chart identifier",
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "type": {
          "type": "string",
          "description": "Chart type",
          "enum": [
            "bar", "line", "scatter", "pie", "area", "histogram",
            "stacked_bar", "grouped_bar", "bubble", "heatmap", "box", "geo"
          ]
        },
        "title": {
          "type": "string",
          "description": "Chart title"
        },
        "x": {
          "type": "string",
          "description": "Column name for X axis"
        },
        "y": {
          "type": "string",
          "description": "Column name for Y axis"
        },
        "agg": {
          "type": "string",
          "description": "Aggregation function",
          "enum": ["sum", "mean", "count"]
        },
        "group": {
          "type": "string",
          "description": "Grouping column (required for stacked_bar, grouped_bar, bubble, heatmap)"
        },
        "size": {
          "type": "string",
          "description": "Size encoding column (required for bubble)"
        },
        "x_type": {
          "type": "string",
          "description": "Explicit type for X axis",
          "enum": ["date", "number", "string"]
        },
        "y_type": {
          "type": "string",
          "description": "Explicit type for Y axis",
          "enum": ["date", "number", "string"]
        },
        "geo_encoding": {
          "type": "string",
          "description": "Country encoding for geo charts (auto-detected if omitted)",
          "enum": ["iso2", "iso3", "name"]
        },
        "bins": {
          "type": "integer",
          "description": "Number of bins (histogram only)",
          "default": 20
        },
        "sort": {
          "type": "string",
          "description": "Sort by field",
          "enum": ["x", "y"]
        },
        "sort_order": {
          "type": "string",
          "description": "Sort direction",
          "enum": ["asc", "desc"],
          "default": "asc"
        },
        "limit": {
          "type": "integer",
          "description": "Maximum number of rows after aggregation",
          "minimum": 1
        },
        "filters": {
          "type": "array",
          "description": "Array of filter conditions applied before aggregation",
          "items": {
            "type": "object",
            "required": ["field", "op", "value"],
            "properties": {
              "field": {
                "type": "string",
                "description": "Column name to filter on"
              },
              "op": {
                "type": "string",
                "description": "Filter operator",
                "enum": ["eq", "ne", "gt", "lt", "gte", "lte", "in", "contains"]
              },
              "value": {
                "description": "Value to compare against (use array for 'in' operator)"
              }
            }
          }
        },
        "x_scale": {
          "type": "string",
          "description": "X-axis scale type",
          "enum": ["linear", "log"],
          "default": "linear"
        },
        "y_scale": {
          "type": "string",
          "description": "Y-axis scale type",
          "enum": ["linear", "log"],
          "default": "linear"
        },
        "annotations": {
          "type": "array",
          "description": "Text annotations overlaid on the chart",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "description": "Annotation text" },
              "x": { "description": "X position (data coordinate or category)" },
              "y": { "description": "Y position (data coordinate)" },
              "color": { "type": "string", "description": "Text color" }
            }
          }
        },
        "reference_lines": {
          "type": "array",
          "description": "Horizontal or vertical reference lines",
          "items": {
            "type": "object",
            "required": ["axis", "value"],
            "properties": {
              "axis": { "type": "string", "enum": ["x", "y"], "description": "Which axis" },
              "value": { "type": "number", "description": "Position value" },
              "label": { "type": "string", "description": "Line label" },
              "style": { "type": "string", "enum": ["solid", "dashed", "dotted"], "default": "dashed" }
            }
          }
        }
      }
    }
  }
}
